# Nexora Admin Backend Environment Variables Example
PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/nexora_admin_db?schema=public"
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
SEED_ADMIN_EMAIL=admin@nexora.id
SEED_ADMIN_PASSWORD=replace-with-secure-seed-password
TENANT_BACKEND_URL=http://localhost:5000

# Internal Inter-Service API Key — MUST match tenant-backend's INTERNAL_API_KEY (min 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

